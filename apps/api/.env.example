# Copy to apps/api/.env for local development.
APP_NAME=MoonRoom
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000

# https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:8000/mal/callback

# Private deployments only. Leave empty anywhere public.
# Names, in priority order. Unless a viewer picked a source by hand, each episode is played from
# the best version for them (their audio, subtitles and quality, see app/ranking.py); the order
# only breaks ties between equal versions, and is the fallback order when a source fails.
# Known sources: zoko, kaa (KickAssAnime, every dub as an audio track), anizone (the same, with
# styled subtitles), uniquestream (AnimeStream: 1080p, a Portuguese dub as its own copy; reachable
# from a home connection only), animesdigital (Portuguese, subtitles burned in), local (your own
# files, converted with `python -m app.library scan`; see deploy/README.md).
VIDEO_SOURCES=
# Folders of converted episodes for the local source, comma-separated. LOCAL_LIBRARY_DIR (one
# folder) still works too.
LOCAL_LIBRARY_DIRS=
