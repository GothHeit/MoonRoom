# Copy to deploy/.env and fill in. Never commit the .env file.

# The address your friends type, with no trailing slash.
PUBLIC_URL=https://moonroom.example.com
APP_NAME=MoonRoom

# Run the Cloudflare Tunnel container. Remove this line on a VPS.
COMPOSE_PROFILES=tunnel
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token.
TUNNEL_TOKEN=

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Only while rotating JWT_SECRET: the old value, removed again a day later (see README).
JWT_PREVIOUS_SECRETS=
# Optional: a separate secret for stream links (the video links a TV or AirPlay receiver plays).
# Empty derives their key from JWT_SECRET. Generate like JWT_SECRET; to rotate, move the old value
# to STREAM_LINK_PREVIOUS_SECRETS for a few hours (links live four hours at most).
STREAM_LINK_SECRET=
STREAM_LINK_PREVIOUS_SECRETS=
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# https://myanimelist.net/apiconfig. The redirect URL there must be PUBLIC_URL + /mal/callback.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# Private deployments only. The order is the tie-break when two sources offer equal versions, and
# the fallback order when one fails. Known sources: zoko, kaa, anizone, uniquestream, animesdigital,
# animedrive, animesonlinecc, animefire, local (your own converted files; needs compose.library.yaml,
# see README).
VIDEO_SOURCES=zoko,animesdigital
# Manga sources, in fallback order. Known sources: mangadex (public API, many languages).
MANGA_SOURCES=mangadex
# Where chapter pages are kept once read, and how much of that disk they may take (MB).
# MANGA_CACHE_DIR=/mnt/d/moonroom-manga-pages
# MANGA_CACHE_MAX_MB=20480
# The local library: uncomment both to serve converted episodes from LIBRARY_DIR (read only).
# COMPOSE_FILE=compose.yaml:compose.library.yaml
# LIBRARY_DIR=/mnt/d/moonroom-library
# A second library folder: add :compose.library-more.yaml to COMPOSE_FILE and set this.
# LIBRARY_DIR_2=/mnt/nas/moonroom-library
# Private deployments only. Fetches Portuguese synopses from an unlicensed site; English otherwise.
PT_SYNOPSIS_SCRAPE=true

# Only change these when testing over plain http on your own network.
# COOKIE_SECURE=false
# SITE_ADDRESS=:80
