{
	# Cloudflare Tunnel (or any private-network proxy) sits in front: believe its client address.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# SITE_ADDRESS is ":80" behind the tunnel; set it to the domain name on a VPS to get automatic HTTPS.
{$SITE_ADDRESS::80} {
	# Don't advertise the server software.
	header -Server

	# Live streams (watch-together rooms) must not wait to fill a compression buffer.
	@compressible not path_regexp ^/api/proxy/watch/rooms/[^/]+/events$
	encode @compressible zstd gzip

	# "Is the site up?" for the TV wrapper, which asks from another origin. When this server or the
	# tunnel is down the answer never carries these headers, which is how the wrapper knows.
	@ping path /api/ping
	handle @ping {
		header Access-Control-Allow-Origin *
		header Cache-Control no-store
		respond "ok" 200
	}

	# MyAnimeList sends the browser here after the user approves the link.
	@mal path /mal/callback
	handle @mal {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Everything else is the web app, which talks to the API on the private network.
	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# While the app restarts (a deploy) or is down, show the moon page, which retries by itself.
	handle_errors {
		@down expression {err.status_code} in [502, 503, 504]
		handle @down {
			header Retry-After 5
			header Cache-Control "no-store"
			rewrite * /offline.html
			root * /srv
			file_server {
				status 503
			}
		}
	}
}
